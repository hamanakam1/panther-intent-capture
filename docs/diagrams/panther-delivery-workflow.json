      "id": "draft-to-review",
      "from": "draft",
      "to": "review",
      "label": "editable draft"
    },
    {
      "id": "review-to-preview",
      "from": "review",
      "to": "preview",
      "label": "confirm one draft"
    },
    {
      "id": "preview-to-ticket",
      "from": "preview",
      "to": "ticket",
      "label": "submit, then read back"
