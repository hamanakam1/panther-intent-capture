  "cards": [
    {
      "dot": "cyan",
      "title": "Two deliveries, one gate",
      "items": [
        "A manual preview shows the exact payload before anything is sent",
        "Automatic delivery is a separate opt-in with a five-ticket cap",
        "Both are read back at the destination before they count as verified"
      ]
    },
    {
      "dot": "amber",
      "title": "Evidence before inference",
      "items": [
        "An evidence draft needs no model at all",
        "Local AI only proposes; it never submits and never executes",
        "A proposal stays a proposal until a person confirms it"
      ]
    }
  ]
